				"type": "text/javascript",
				"exec": [
					"function generateTraceId(length = 32) {",
					"  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';",
					"  const charsLength = chars.length;",
					"",
					"",
					"  ",
					"  let traceId = '';",
					"  for (let i = 0; i < length; i++) {",
					"    traceId += chars[getRandomInteger(1, charsLength)];",
					"  }",
					"  ",
					"    pm.collectionVariables.set(\"traceId\", traceId);",
					"  return traceId;",
					"}",
					"",
					"function getRandomInteger(min, max) {",
					"  return Math.floor(Math.random() * (max - min + 1)) + min;",
					"}",
					"",
					"function addHeader(){",
					"const value = pm.collectionVariables.get(\"session_id\");",
					"    console.log(\"From collection:\", value);",
					"  ",
					"            // Only upsert after the jar is successfully cleared",
					"            pm.request.headers.upsert({",
					"                key: \"Cookie\",",
					"                value: value",
					"            });",
					"}",
					"",
					"addHeader();",
					"generateTraceId(32);"
				]
			}
		},
